genrule(
    name = "gen_init_cpio_x64",
    srcs = ["@linux_4.9//:gen_init_cpio.c"],
    outs = ["gen_init_cpio"],
    cmd = "gcc -o $@ $<",
)

constraint_setting(name = "linux_version")
build_linux_image("4.9")
build_linux_image("4.19")
build_linux_image("5.4")
build_linux_image("6.6")

