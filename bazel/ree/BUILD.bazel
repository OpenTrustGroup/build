        "@ree//libnbl_secmgr_ree:headers",
        "@ree//libnbl_license_ree:headers",
        "@ree//libtrusty:headers",
        "@ree//openssl:gen-android-arm64-v8a",
        "@zircon//:uapi_err_hdr",
    ],
    outs = ["includes_ndk"],
    cmd = """
    for f in $(SRCS); do
      ext="$${f##*.}"
      if [[ $${ext} != h ]]; then
        continue
      fi
      d="$${f%/*}"
      d="$${d#bazel-out/*/genfiles/}"
      d="$${d#bazel-out/*/bin/}"

      if [[ $${d} == external* ]]; then
        extname="$${d#*external/}"
        extname="$${extname%%/*}"

        d="$${d#*external/zircon/trusty/lk/}"
        d="$${d/uapi\\/uapi/trusty\\/uapi}"
        d="$${d/android-arm64-v8a\\//}"

        d="$${d#*external/$${extname}/}"
      fi

      mkdir -p "$@/$${d}"
      cp "$${f}" "$@/$${d}/"
    done
    """,
)

genrule(
    name = "install_libraries_ndk",
    srcs = [
        "@ree//libion:arm64-v8a",
        "@ree//libion_mtk:arm64-v8a",
        "@ree//openssl:gen-android-arm64-v8a",
        "@ree//uree/libgz_uree:arm64-v8a",
        "@ree//:ndk-build",
    ],
    outs = ["libs_ndk"],
    cmd = """
    for f in $(SRCS); do
      ext="$${f##*.}"
      if [[ $${ext} != so ]] && [ $${ext} != a ]; then
        continue
      fi
      d="$${f%/*}"
      d="$${d#bazel-out/*/genfiles/}"
      d="$${d#bazel-out/*/bin/}"
      d="$${d#*/ndk/}"

      if [[ $${d} == external* ]]; then
        extname="$${d#*external/}"
        extname="$${extname%%/*}"

        d="$${d#*external/$${extname}/}"
      fi

      # Openssl
      d="$${d/android-arm64-v8a\\/lib/libs\\/arm64-v8a}"

      # Formalize the names according to NDK layout
      # shared: [modname]/libs/[arch]/xxx.so, no changes
      # static: [modname]/obj/local/[arch]/xxx.a -> [modname]/libs/[arch]/xxx.a

      arch="$${d##*/}"
      d="$${d%/*}"
      d="$${d%/libs}"
      d="$${d%/obj/local}"
      d="$${d##*/}"
      d="$${d}/libs/$${arch}"

      mkdir -p "$@/$${d}"
      cp "$${f}" "$@/$${d}/"
    done
    """,
)

genrule(
    name = "install_binaries_ndk",
    srcs = [
        "@ree//:ndk-build",
    ],
    outs = ["bins_ndk"],
    cmd = """
    for f in $(SRCS); do
      ext="$${f##*.}"
      if [[ $${ext} == so ]] || [ $${ext} == a ]; then
        continue
      fi
      d="$${f%/*}"
      d="$${d#bazel-out/*/genfiles/}"
      d="$${d#bazel-out/*/bin/}"
      d="$${d#*/ndk/}"

      if [[ $${d} == external* ]]; then
        extname="$${d#*external/}"
        extname="$${extname%%/*}"

        d="$${d#*external/$${extname}/}"
      fi

      # extract arm64-v8a binary only
      arch="$${d##*/}"
      if [[ $${arch} != "arm64-v8a" ]]; then
        continue
      fi
      d="$${d%*/libs/$${arch}}"

      mkdir -p "$@/$${d}"
      cp "$${f}" "$@/$${d}/"
    done
    """,
)

genrule(
    name = "install_nbl_sdk_artifacts",
    srcs = [
        "@ree//:ndk-build",
        "@ree//uree/libgz_uree:arm64-v8a",
        "@ree//libion:arm64-v8a",
        "@ree//libion_mtk:arm64-v8a",
        "@ree//libnbl_attest_ree:headers",
        "@ree//libnbl_fwk_ree:headers",
        "@ree//libnbl_loader_ree:headers",
        "@ree//libnbl_secmgr_ree:headers",
        "@ree//libnbl_license_ree:headers",
        "@googletest//:headers",
        "@ree//libtrusty:headers",
    ],
    outs = ["aar"],
    cmd = """
    LOCAL_PATH="$$(dirname $(location @nbl_sdk//:ROOT))"

    export JAVA_HOME="$$(dirname $$(dirname $$(readlink -f $$(which javac))))"
    export JRE_HOME=$${JAVA_HOME}/jre
    export CLASSPATH=.:$${JAVA_HOME}/lib:$${JRE_HOME}/lib
    export PATH=$${JAVA_HOME}/bin:$$PATH

    export ANDROID_HOME="$${ANDROID_SDK_HOME}"
    export PATH=$${ANDROID_SDK_HOME}/tools:$${PATH}
    export PATH=$${ANDROID_SDK_HOME}/platform-tools:$${PATH}
    export FUCHSIA_OUT_DIR="$$(realpath $(BINDIR))"

    unset ANDROID_NDK_HOME

    pushd "$${LOCAL_PATH}" > /dev/null
    ./gradlew clean
    ./gradlew assembleDebug
    ./gradlew JavaDocJar
    popd > /dev/null

    OUTPUT_AAR="$${LOCAL_PATH}/nbl_sdk/build/outputs/aar/nbl_sdk-debug.aar"
    OUTPUT_JAR="$${LOCAL_PATH}/nbl_sdk/build/libs/nbl_sdk-javadoc.jar"
    TMPDIR="$${LOCAL_PATH}/nbl_sdk/build/outputs/aar/tmp"
    mkdir -p $${TMPDIR}
    unzip $${OUTPUT_AAR} -d $${TMPDIR}

    $(location @scripts//:gen_prefab) -i $(SRCS) -o $${TMPDIR}

    pushd "$${TMPDIR}" > /dev/null
    zip -r -FS out.zip *
    popd > /dev/null

    mkdir -p $@
    cp $${TMPDIR}/out.zip $@/nbl_sdk.aar
    cp $${OUTPUT_JAR} $@/nbl_sdk-javadoc.jar
    cp $${LOCAL_PATH}/nbl_sdk.gradle $@/nbl_sdk.gradle
    cp $${LOCAL_PATH}/platform.keystore $@/platform.keystore
    """,
    local = True,
    tools = [
        "@nbl_sdk//:ROOT",
        "@nbl_sdk//:all",
        "@scripts//:gen_prefab",
    ],
)

copy_single_file(
    src = "@scripts//aosp:platform_keystore",
    dst = "keystore/platform.keystore",
)
