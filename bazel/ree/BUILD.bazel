genrule(
    name = "generate-cpio-rootfs",
    srcs = [
        ":gen_init_cpio_x64",
        "@gen_rootfs//:all",
        "@gen_rootfs//:ROOT",
        "@busybox//:all",
        "@busybox//:ROOT",
    ],
    outs = ["gen_root/filelist-final.txt"],
    cmd = """
    export PATH=$${PATH}:$$(dirname $$(realpath $(location :gen_init_cpio_x64)))
    export BUSYBOX_PATH=$$(dirname $$(realpath $(location @busybox//:ROOT)))
    export ROOTFS_SRC=$$(dirname $$(realpath $(location @gen_rootfs//:ROOT)))
    export ROOTFS_BUILDROOT=$$(realpath $(@D))
    if [[ -n "$${CCACHE_DIR}" ]] && [[ -d "$${CCACHE_DIR}" ]]; then
      export CROSS_COMPILE="$$(which ccache) $${GCC_TOOLCHAIN_PREFIX}/aarch64-linux-gnu-"
    else
      export CROSS_COMPILE="$${GCC_TOOLCHAIN_PREFIX}/aarch64-linux-gnu-"
    fi
    echo "CROSS_COMPILE: $${CROSS_COMPILE}"

    mkdir -p $${ROOTFS_BUILDROOT}
    cd $${ROOTFS_SRC} && ./generate-cpio-rootfs.sh $${TEE_SPD} fvp
    """,
    local = True,
)

