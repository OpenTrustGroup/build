genrule(
    name = "nbl_otrp_sdk",
    srcs = [
        "@nbl_otrp_sdk//:all",
        "@nbl_otrp_sdk//:ROOT",
        "@ree//:ndk-build",
        "@ree//uree/libgz_uree:arm64-v8a",
        "@ree//libion:arm64-v8a",
        "@ree//libion_mtk:arm64-v8a",
        "@ree//libtrusty:headers",
        "@ree//libnbl_fwk_ree:headers",
        "@ree//libnbl_secmgr_ree:headers",
        "@ree//libnbl_loader_ree:headers",
    ],
    outs = ["build-android-apps/nbl_otrp_sdk/outputs/apk/debug/app-debug.apk"],
    cmd = """
    NDK_OUT="$(locations @ree//:ndk-build)"
    LIB_UREE="$(location @ree//uree/libgz_uree:arm64-v8a)"
    SDK_ROOT="$$(dirname $(location @nbl_otrp_sdk//:ROOT))"
    JNI_DIR="$${SDK_ROOT}/app/src/main/jni/jni_libs"

    rm -rf $${JNI_DIR}/*

    # fwk_ree & trusty
    FWK_DIR="$${JNI_DIR}/nbl_fwk_ree"
    FWK_OUT="$${FWK_DIR}/arm64-v8a"
    TRUSTY_DIR="$${JNI_DIR}/trusty"
    TRUSTY_OUT="$${TRUSTY_DIR}/arm64-v8a"
    mkdir -p "$${FWK_OUT}"
    mkdir -p "$${TRUSTY_OUT}"
    cp $(location @ree//libnbl_loader_ree:headers) "$${FWK_DIR}"
    cp $(location @ree//libnbl_secmgr_ree:headers) "$${FWK_DIR}"
    cp $(locations @ree//libnbl_fwk_ree:headers) "$${FWK_DIR}"
    cp $(locations @ree//libtrusty:headers) "$${TRUSTY_DIR}"

    for f in $(locations @ree//:ndk-build); do
      case $${f} in
        *arm64-v8a/libnbl_loader_ree.a | *arm64-v8a/libnbl_secmgr_ree.a | *arm64-v8a/libnbl_fwk_ree.a)
          cp -f "$${f}" "$${FWK_OUT}"
          ;;
        *arm64-v8a/libnbl_trusty.a)
          cp -f "$${f}" "$${TRUSTY_OUT}"
          ;;
      esac
    done

    ## ion
    ION_OUT="$${JNI_DIR}/ion/arm64-v8a"
    ION_MTK_OUT="$${JNI_DIR}/ion_mtk/arm64-v8a"
    mkdir -p "$${ION_OUT}"
    cp "$(location @ree//libion:arm64-v8a)" "$${ION_OUT}"
    mkdir -p "$${ION_MTK_OUT}"
    cp "$(location @ree//libion_mtk:arm64-v8a)" "$${ION_MTK_OUT}"

    # uree
    UREE_OUT="$${JNI_DIR}/arm64-v8a"
    mkdir -p "$${UREE_OUT}"
    cp "$(location @ree//uree/libgz_uree:arm64-v8a)" "$${UREE_OUT}"

    export JAVA_HOME="$$(dirname $$(dirname $$(readlink -f $$(which javac))))"
    export JRE_HOME=$${JAVA_HOME}/jre
    export CLASSPATH=.:$${JAVA_HOME}/lib:$${JRE_HOME}/lib
    export PATH=$${JAVA_HOME}/bin:$$PATH

    export ANDROID_HOME="$${ANDROID_SDK_HOME}"
    export PATH=$${ANDROID_SDK_HOME}/tools:$${PATH}
    export PATH=$${ANDROID_SDK_HOME}/platform-tools:$${PATH}
    export FUCHSIA_OUT_DIR="$$(realpath $(BINDIR))"

    unset ANDROID_NDK_HOME

    pushd "$${SDK_ROOT}" > /dev/null
    ./gradlew clean
    ./gradlew assembleDebug
    popd > /dev/null
    """,
    local = True,
)

genrule(
    name = "install_headers_qemu",
    srcs = [
        "@ree//libnbl_fwk_ree:headers",
        "@ree//libnbl_loader_ree:headers",
        "@ree//libnbl_secmgr_ree:headers",
        "@ree//libnbl_license_ree:headers",
        "@ree//libtrusty:headers",
        "@ree//openssl:gen-linux-aarch64",
        "@zircon//:uapi_err_hdr",
    ],
    outs = ["includes_qemu"],
    cmd = """
    for f in $(SRCS); do
      ext="$${f##*.}"
      if [[ $${ext} != h ]]; then
        continue
      fi
      d="$${f%/*}"
      d="$${d#bazel-out/*/genfiles/}"
      d="$${d#bazel-out/*/bin/}"

      if [[ $${d} == external* ]]; then
        extname="$${d#*external/}"
        extname="$${extname%%/*}"

        d="$${d#*external/zircon/trusty/lk/}"
        d="$${d/uapi\\/uapi/trusty\\/uapi}"

        d="$${d/linux-aarch64\\//}"
        d="$${d#*external/$${extname}/}"
      fi

      mkdir -p "$@/$${d}"
      cp "$${f}" "$@/$${d}/"
    done
    """,
)

genrule(
    name = "install_libraries_qemu",
    srcs = [
        "@ree//libnbl_fwk_ree:nbl_fwk_ree",
        "@ree//libnbl_loader_ree:nbl_loader_ree",
        "@ree//libnbl_secmgr_ree:nbl_secmgr_ree",
        "@ree//libnbl_license_ree:nbl_license_ree",
        "@ree//libtrusty:nbl_trusty",
        "@ree//openssl:gen-linux-aarch64",
    ],
    outs = ["libs_qemu"],
    cmd = """
    for f in $(SRCS); do
      ext="$${f##*.}"
      if [[ $${ext} != so ]] && [ $${ext} != a ]; then
        continue
      fi
      d="$${f%/*}"
      d="$${d#bazel-out/*/genfiles/}"
      d="$${d#bazel-out/*/bin/}"

      if [[ $${d} == external* ]]; then
        extname="$${d#*external/}"
        extname="$${extname%%/*}"

        d="$${d/linux-aarch64\\/lib/}"
        d="$${d#*external/$${extname}/}"
      fi

      d="$${d}/lib"
      mkdir -p "$@/$${d}"
      cp "$${f}" "$@/$${d}/"
    done
    """,
)

